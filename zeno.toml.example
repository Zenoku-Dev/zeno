# Пример конфига zeno. Скопируйте в ~/.zeno/config.toml или ./zeno.toml и отредактируйте.

# ClamAV через демон clamd (TCP INSTREAM). Если clamd_host не задан — пропускается.
clamd_host = "127.0.0.1"
clamd_port = 3310

# Необязательно: бесплатный Auth-Key выдаётся на bazaar.abuse.ch
# (без ключа запрос к MalwareBazaar пропускается; с неверным — ошибка в выводе)
malwarebazaar_auth_key = ""

# Лимит размера файла для хэширования, МБ (по умолчанию 200).
# max_file_size_mb = 200

# Директории, которые пропускаются при сканировании папки
# (по умолчанию: .git .svn .hg node_modules target __pycache__)
# ignore_dirs = [".git", "node_modules", "target"]

# Динамический запуск (docs/emulation.md), все ключи необязательны:
# cuckoo_url = "http://127.0.0.1:8090"   # веб-API Cuckoo3, для --target windows
# cuckoo_token = ""                      # cuckoo api token --list
# zeno_alpine_image = "alpine:latest"    # образ docker для --target alpine
# osx_kvm_path = "/home/me/OSX-KVM"      # клон OSX-KVM, для --target macos

# Внешние движки: cmd + args, {path} заменяется на путь к проверяемому файлу.

# ClamAV через CLI:
[engine.clamscan]
cmd = "clamscan"
args = ["--no-summary", "{path}"]

# YARA-X (движок разработки VirusTotal, github.com/VirusTotal/yara-x):
# [engine.yarax]
# cmd = "yarax"
# args = ["--rules", "C:/yara-rules/index.yar", "{path}"]
